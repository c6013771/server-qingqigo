# ===== 数据库密码（务必改成强密码） =====
MYSQL_ROOT_PASSWORD=change-me-mysql-strong-password
REDIS_PASSWORD=change-me-redis-strong-password

# ===== 后端服务（docker 网络内用服务名访问 MySQL/Redis） =====
PORT=3000
DATABASE_URL="mysql://root:change-me-mysql-strong-password@mysql:3306/qingqigo"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-strong-password

# ===== JWT（换成随机长字符串，如 openssl rand -hex 32） =====
JWT_SECRET=change-me-random-secret
JWT_EXPIRES_IN=7d

# ===== 和风天气 =====
QWEATHER_API_KEY=你的key
QWEATHER_API_HOST=你的host.re.qweatherapi.com

# ===== 高德 IP 定位（Web 服务 Key，lbs.amap.com 免费申请；国内 IP 定位首选源） =====
AMAP_API_KEY=你的高德key

# ===== SMTP 邮件 =====
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=noreply@qingqier.com
SMTP_PASS=你的SMTP授权码
MAIL_FROM=noreply@qingqier.com
