# 服务端口
PORT=3000

# MySQL 连接串（与 docker-compose.yml 中的账号保持一致）
DATABASE_URL="mysql://root:root123456@localhost:3306/qingqigo"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# 和风天气（https://dev.qweather.com 控制台申请）
QWEATHER_API_KEY=your-qweather-api-key
# 新版控制台分配的独立 API Host（如 abcxyz.qweatherapi.com）；旧版免费 key 保持默认即可
QWEATHER_API_HOST=devapi.qweather.com
