# 服务端口
PORT=3000

# MySQL 连接串（与 docker-compose.yml 中的账号保持一致）
DATABASE_URL="mysql://root:root123456@localhost:3306/qingqigo"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=7d

# 站点图标本地存储目录与对外访问地址（生产建议填 https://api.qingqier.com）
ICON_STORAGE_DIR=./storage/icons
ICON_PUBLIC_BASE_URL=http://localhost:4321/
# 图标防盗链白名单（逗号分隔域名；为空不限制，无 Referer 的直接访问始终放行）
ICON_ALLOWED_REFERERS=http://localhost:4321/

# 和风天气（https://dev.qweather.com 控制台申请）
QWEATHER_API_KEY=your-qweather-api-key
# 新版控制台分配的独立 API Host（如 abcxyz.qweatherapi.com）；旧版免费 key 保持默认即可
QWEATHER_API_HOST=devapi.qweather.com
# ===== 高德 IP 定位（Web 服务 Key，lbs.amap.com 免费申请；国内 IP 定位首选源） =====
AMAP_API_KEY=你的高德key

# SMTP 邮件服务（注册验证码）
# QQ 邮箱：smtp.qq.com，密码填「授权码」（设置 → 账号 → 开启 SMTP 获取）
# 163 邮箱：smtp.163.com，同样用授权码；Gmail：smtp.gmail.com + 应用专用密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
MAIL_FROM=your-email@qq.com
