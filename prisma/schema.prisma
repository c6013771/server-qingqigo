generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  phone        String?         @unique
  email        String?         @unique
  wxOpenid     String?         @unique @map("wx_openid")
  passwordHash String?         @map("password_hash")
  nickname     String?
  avatarUrl    String?         @map("avatar_url")
  role         String          @default("user")
  navVersion   Int             @default(0) @map("nav_version")
  createdAt    DateTime        @default(now()) @map("created_at")
  lastLoginAt  DateTime?       @map("last_login_at")
  favorites    UserFavorite[]
  requests     FeatureRequest[]
  votes        RequestVote[]
  navCategories UserNavCategory[]
  feedbacks    Feedback[]

  @@map("users")
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_favorites")
}

model UserNavCategory {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  label       String
  /** 是否为系统内置分类的副本（用户登录后初始化，可自由编辑/删除） */
  isBuiltin   Boolean       @default(false) @map("is_builtin")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sites       UserNavSite[]

  @@map("user_nav_categories")
}

model UserNavSite {
  id         String          @id @default(uuid())
  categoryId String          @map("category_id")
  name       String
  url        String
  desc       String?
  icon       String?
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at")
  category   UserNavCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("user_nav_sites")
}

/** 站点图标本地化缓存：按 host 全局去重，所有用户共享同一份落盘图标 */
model SiteIcon {
  id          String   @id @default(uuid())
  /** 站点 host（最终 origin 的 hostname），全局去重键 */
  host        String   @unique
  /** 落盘文件名，如 docs.qq.com.png */
  fileName    String   @map("file_name")
  /** 原始远程图标地址，便于排查/后续刷新 */
  sourceUrl   String   @map("source_url")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_icons")
}

enum RequestType {
  ADD_SITE    @map("add_site")
  ADD_FEATURE @map("add_feature")
  IMPROVEMENT @map("improvement")
  OTHER       @map("other")
}

enum RequestStatus {
  PENDING    @map("pending")
  EVALUATING @map("evaluating")
  ACCEPTED   @map("accepted")
  DEVELOPING @map("developing")
  RELEASED   @map("released")
  REJECTED   @map("rejected")
}

model FeatureRequest {
  id          String        @id @default(uuid())
  requestNo   String        @unique @map("request_no")
  userId      String?       @map("user_id")
  type        RequestType
  title       String
  description String?
  url         String?
  contact     String?
  status      RequestStatus @default(PENDING)
  adminNote   String?       @map("admin_note")
  upvotes     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes       RequestVote[]

  @@map("feature_requests")
}

model RequestVote {
  id        String         @id @default(uuid())
  requestId String         @map("request_id")
  userId    String         @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@map("request_votes")
}

/** 用户意见反馈（前端「意见反馈」弹窗；type/status 存小写字符串，与前端契约一致） */
model Feedback {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  /** feature 功能建议 / bug 问题反馈 / site 站点收录 */
  type         String   @db.VarChar(20)
  content      String   @db.VarChar(1000)
  /** 用户预留的联系邮箱，便于回复通知 */
  contactEmail String?  @map("contact_email") @db.VarChar(100)
  /** pending 待处理 / processing 处理中 / replied 已回复 / done 已完成 / rejected 已拒绝 */
  status       String   @default("pending") @db.VarChar(20)
  /** 管理员回复内容 */
  reply        String?  @db.VarChar(2000)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedbacks")
}
